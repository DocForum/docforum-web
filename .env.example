# Copy to .env.local and adjust. PROVISIONAL — docforum-core has no
# implemented API yet; this is the assumed local dev port, not a confirmed
# contract. See src/services/api-client.ts.
VITE_API_BASE_URL=http://localhost:4000

# Age at which a dependent needs their own account (default 18). This mirrors
# docforum-core's rule; the server stays authoritative.
# VITE_AGE_OF_MAJORITY_YEARS=18
