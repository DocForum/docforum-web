# Copy to .env.local and adjust. PROVISIONAL — docforum-core has no
# implemented API yet; this is the assumed local dev port, not a confirmed
# contract. See src/services/api-client.ts.
VITE_API_BASE_URL=http://localhost:4000

# Stellar explorer base for display-only links (issue #10). Defaults to
# Stellar Expert's testnet/public explorer; switch to mainnet here when the
# escrow network does (no code change). This repo never queries Stellar.
# VITE_STELLAR_EXPLORER_BASE_URL=https://testnet.stellar.expert/explorer/public

# Error monitoring (disabled unless set). Set to a Sentry DSN to enable
# automatic error capture in production. The Pages preview ships without
# this, so monitoring is off by default. All captured events are scrubbed
# by src/utils/phi-scrubber.ts before they leave the browser — see
# ARCHITECTURE_ESSENTIALS.md "Known assumptions — Error monitoring".
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# Router selection (issue #119 — docs/adr/0001-routing-strategy.md).
# Set to "true" for GitHub Pages deployments (no server-side rewrites).
# Omit or set to "false" for any host with rewrite support (Cloudflare Pages,
# Netlify, or when served directly by docforum-core).
# VITE_USE_HASH_ROUTER=true

# Privacy-preserving analytics (issue #118).
# Omit both to disable analytics entirely (default).
# Set VITE_ANALYTICS_ENDPOINT to a self-hosted Plausible/Umami events URL.
# Set VITE_ANALYTICS_DOMAIN to the site domain the analytics tool uses.
# VITE_ANALYTICS_ENDPOINT=https://analytics.example.com/api/event
# VITE_ANALYTICS_DOMAIN=docforum.example.com
