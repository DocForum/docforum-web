{
  "name": "docforum-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_ENABLE_MOCKS=true vite",
    "build": "tsc -b && vite build",
    "prebuild": "npm run generate:api",
    "build:pages": "tsc -b && GITHUB_PAGES=true vite build",
    "check:dist": "node scripts/check-dist-no-mocks.mjs",
    "check:stellar-boundary": "node scripts/check-stellar-boundary.mjs",
    "preview": "vite preview",
    "generate:api": "node packages/api-client/scripts/generate.mjs",
    "check:api-client": "node packages/api-client/scripts/check-version.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "pretypecheck": "npm run generate:api",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --project=visual-desktop --project=visual-mobile --update-snapshots"
  },
  "dependencies": {
    "@docforum/api-client": "file:packages/api-client",
    "@hookform/resolvers": "^6.0.0",
    "@sentry/react": "^11.8.0",
    "@tanstack/react-query": "^5.102.8",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.91.0",
    "react-intl": "^7.1.14",
    "react-router-dom": "^7.18.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.14.5",
    "jest-axe": "^11.0.0",
    "msw": "^2.15.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "yaml": "^2.9.1"
  }
}
