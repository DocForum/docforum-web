# react-intl declares an optional peer on TypeScript ^5.6, but this repo uses
# the TypeScript 7 native compiler. The peer is only used by react-intl's
# build-time type tooling, not at runtime, so installs intentionally skip
# strict peer resolution. Kept in the repo so `npm ci` (CI) resolves the same
# tree as local installs.
legacy-peer-deps=true
